# EasyCode 模型配置
#
# 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 排除，不会提交）。
# 这些配置只有 Core 进程会读取，渲染进程永远拿不到 API Key。

# OpenAI 兼容协议的接口地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 接口密钥
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 使用的模型 ID
OPENAI_MODEL=gpt-4o

# 模型上下文窗口大小（可选，默认 128000）
# compaction（压缩）机制依赖这个值判断何时执行，填小了会导致过早执行 compaction，填大了会撞上下文上限
OPENAI_MODEL_CONTEXT_WINDOW=128000

# 单轮回复的最大输出 token 数（可选，默认 8192）
# 小上下文窗口下 Runner 会进一步收紧有效输出上限，保证输入和输出都能放进模型窗口
OPENAI_MAX_OUTPUT_TOKENS=8192

# 采样温度（可选，留空时不发送该字段）
OPENAI_TEMPERATURE=

# 附加请求头（可选，格式 KEY1=VALUE1,KEY2=VALUE2）
OPENAI_EXTRA_HEADERS=

# 联网搜索与网页读取（可选）
# 每项能力必须同时配置 Provider 和对应 API Key，否则不会注册该工具。
# 可用 Provider：deepseek / glm / tavily
EASYCODE_WEB_SEARCH_PROVIDER=
EASYCODE_WEB_SEARCH_API_KEY=
EASYCODE_WEB_FETCH_PROVIDER=
EASYCODE_WEB_FETCH_API_KEY=

EASYCODE_WEB_TIMEOUT_MS=30000
EASYCODE_WEB_MAX_RESPONSE_BYTES=8388608
EASYCODE_WEB_USER_AGENT=EasyCode/0.1

# 数据目录（可选，默认 ~/easycode/.easycode）
# 会话事件日志、context snapshot（快照）、工具输出落盘都在这里。
# 支持以 ~ 开头表示用户主目录；留空则使用上面的默认值。
EASYCODE_DATA_DIR=

# 日志级别（可选，默认 info）
# 可选值：debug / info / warn / error。日志统一写 stderr，不会污染命令行输出。
EASYCODE_LOG_LEVEL=info
