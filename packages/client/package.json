{
  "name": "@easycode/client",
  "version": "0.1.0",
  "private": true,
  "description": "EasyCode 的类型化客户端 SDK：包装本地 HTTP 与 SSE 接口",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@easycode/protocol": "*",
    "@easycode/schema": "*",
    "zod": "^3.24.1"
  }
}
