{
  "name": "@easycode/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EasyCode 桌面端：Electron 外壳、本地 sidecar 与 React 渲染层",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:sidecar && npm run build:renderer",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/main/index.cjs --sourcemap",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/preload/index.cjs --sourcemap",
    "build:sidecar": "esbuild src/sidecar/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/sidecar/index.cjs --sourcemap",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@easycode/client": "*",
    "@easycode/core": "*",
    "@easycode/protocol": "*",
    "@easycode/schema": "*",
    "@easycode/server": "*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.0"
  }
}
