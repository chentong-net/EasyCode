{
  "name": "@easycode/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "EasyCode 的 HTTP 传输契约：端点常量、DTO 与错误标签",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
